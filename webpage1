<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Student Dashboard</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, Helvetica, sans-serif;
        }

        body{
            background:#f2f4f8;
        }

        header{
            background:#1f3c88;
            color:white;
            padding:20px;
            text-align:center;
        }

        nav{
            display:flex;
            justify-content:center;
            background:#0f2557;
        }

        nav a{
            color:white;
            text-decoration:none;
            padding:15px 25px;
            transition:0.3s;
        }

        nav a:hover{
            background:#3b5fc0;
        }

        .hero{
            height:350px;
            background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),
            url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=1200");
            background-size:cover;
            background-position:center;
            display:flex;
            justify-content:center;
            align-items:center;
            flex-direction:column;
            color:white;
        }

        .hero h1{
            font-size:50px;
            margin-bottom:15px;
        }

        .hero p{
            font-size:20px;
        }

        .hero button{
            margin-top:20px;
            padding:12px 30px;
            border:none;
            background:orange;
            color:white;
            font-size:18px;
            cursor:pointer;
            border-radius:5px;
        }

        .hero button:hover{
            background:red;
        }

        .container{
            width:90%;
            margin:auto;
            padding:40px 0;
        }

        .cards{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
            gap:20px;
        }

        .card{
            background:white;
            padding:20px;
            border-radius:10px;
            box-shadow:0 0 10px gray;
            transition:0.3s;
        }

        .card:hover{
            transform:translateY(-8px);
        }

        .card h2{
            color:#1f3c88;
            margin-bottom:10px;
        }

        table{
            width:100%;
            margin-top:40px;
            border-collapse:collapse;
        }

        table th,table td{
            padding:15px;
            border:1px solid gray;
            text-align:center;
        }

        table th{
            background:#1f3c88;
            color:white;
        }

        form{
            margin-top:50px;
            background:white;
            padding:30px;
            border-radius:10px;
            box-shadow:0 0 10px gray;
        }

        input{
            width:100%;
            padding:12px;
            margin:10px 0;
        }

        textarea{
            width:100%;
            height:120px;
            padding:10px;
        }

        input[type=submit]{
            background:green;
            color:white;
            border:none;
            cursor:pointer;
        }

        footer{
            background:#0f2557;
            color:white;
            text-align:center;
            padding:20px;
            margin-top:40px;
        }

        #clock{
            font-size:25px;
            margin-top:10px;
            color:yellow;
        }
    </style>

</head>

<body>

<header>

    <h1>Student Management Website</h1>

    <div id="clock"></div>

</header>

<nav>

    <a href="#">Home</a>
    <a href="#">Courses</a>
    <a href="#">Faculty</a>
    <a href="#">Gallery</a>
    <a href="#">Contact</a>

</nav>

<section class="hero">

    <h1>Welcome Students</h1>

    <p>Learn HTML, CSS and JavaScript with Live Projects</p>

    <button onclick="welcome()">
        Get Started
    </button>

</section>

<div class="container">

<h1 align="center">Popular Courses</h1>

<br>

<div class="cards">

<div class="card">
<h2>HTML</h2>
<p>
HTML is used to create the structure of web pages.
It defines headings, paragraphs, images, tables,
forms and many more elements.
</p>
</div>

<div class="card">
<h2>CSS</h2>
<p>
CSS makes web pages attractive using colors,
fonts, layouts, animations and responsive
design techniques.
</p>
</div>

<div class="card">
<h2>JavaScript</h2>
<p>
JavaScript adds dynamic functionality such as
buttons, forms, calculations, animations and
interactive features.
</p>
</div>

<div class="card">
<h2>Bootstrap</h2>
<p>
Bootstrap provides ready-made responsive
components that help developers build websites
quickly.
</p>
</div>

</div>

<table>

<tr>

<th>ID</th>
<th>Name</th>
<th>Course</th>
<th>Duration</th>

</tr>

<tr>

<td>101</td>
<td>Rahul</td>
<td>HTML</td>
<td>1 Month</td>

</tr>

<tr>

<td>102</td>
<td>Priya</td>
<td>CSS</td>
<td>2 Months</td>

</tr>

<tr>

<td>103</td>
<td>Arjun</td>
<td>JavaScript</td>
<td>3 Months</td>

</tr>

<tr>

<td>104</td>
<td>Divya</td>
<td>Bootstrap</td>
<td>1 Month</td>

</tr>

</table>

<form onsubmit="return submitForm()">

<h2>Contact Us</h2>

<input
type="text"
id="name"
placeholder="Enter Your Name"
required>

<input
type="email"
id="email"
placeholder="Enter Email"
required>

<textarea
id="msg"
placeholder="Enter Message">
</textarea>

<input
type="submit"
value="Send">

</form>

</div>

<footer>

<h3>
Copyright © 2026 Student Management System
</h3>

</footer>

<script>

function welcome(){

    alert(
    "Welcome to the Student Management Website!"
    );

}

function submitForm(){

    let name =
    document.getElementById("name").value;

    let email =
    document.getElementById("email").value;

    let message =
    document.getElementById("msg").value;

    if(name=="" || email==""){

        alert(
        "Please fill all required fields."
        );

        return false;

    }

    alert(

    "Form Submitted Successfully\n\n"+
    "Name : "+name+
    "\nEmail : "+email+
    "\nMessage : "+message

    );

    return false;

}

function showClock(){

    let date =
    new Date();

    let time =
    date.toLocaleTimeString();

    document.getElementById("clock").innerHTML =
    time;

}

setInterval(showClock,1000);

showClock();

</script>

</body>
</html>